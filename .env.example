# Backend
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/interview_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/interview_sandbox_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_long_random_secret
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_CALLBACK_URL=http://localhost:5000/api/executions/judge0/callback
JUDGE0_CALLBACK_SECRET=secret_token_for_webhooks
JUDGE0_CPU_TIME_LIMIT=2.0
JUDGE0_WALL_TIME_LIMIT=5.0
JUDGE0_MEMORY_LIMIT=128000
# Optional: Judge0 Polling Fallback (auto-enabled when JUDGE0_CALLBACK_URL points to localhost / 127.0.0.1)
# JUDGE0_ENABLE_POLLING=true
# JUDGE0_POLL_INTERVAL_MS=1000
# JUDGE0_POLL_MAX_ATTEMPTS=15

# Frontend
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=ws://localhost:5000
